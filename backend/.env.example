# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Drive: public latest.json pointer maintained by scripts/drive-publisher.gs
DRIVE_LATEST_FILE_ID=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Database
DATABASE_URL=sqlite:///./the_list.db

# FAISS
FAISS_INDEX_PATH=./data/faiss

# Google Maps (Places API — venue address, lat/lng, place_id)
GOOGLE_MAPS_API_KEY=

# Retention
DATA_RETENTION_DAYS=90

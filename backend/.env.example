# Every setting is described in docs/guide/configuration.md (https://list.sturgis.me/docs/configuration/).

# Required for an ingest
# Google Drive: public latest.json pointer maintained by scripts/drive-publisher.gs
DRIVE_LATEST_FILE_ID=
# Google Maps (Places API — venue address, lat/lng, place_id)
GOOGLE_MAPS_API_KEY=

# Band lookups (optional; without a key that service is skipped)
#LASTFM_API_KEY=
#DISCOGS_CONSUMER_KEY=
#DISCOGS_CONSUMER_SECRET=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Database
DATABASE_URL=sqlite:///./the_list.db

# FAISS
FAISS_INDEX_PATH=./data/faiss

# Retention
DATA_RETENTION_DAYS=90

# Weekly Alerts (optional; only `python -m app.cli alerts` needs them)
#SUPABASE_URL=
#SUPABASE_SERVICE_ROLE_KEY=
#RESEND_API_KEY=

# Anthropic (optional; only for refreshing a Venue's details by hand)
#ANTHROPIC_API_KEY=

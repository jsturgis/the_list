# The backend's direct dependencies, with the lowest versions it works with. requirements.txt is these resolved to
# exact versions (with everything they depend on), and is what Docker, CI and the workflows install, so an upstream
# release changes nothing until it's committed. To update after editing this file, or to take new releases:
#   docker run --rm -v "$PWD:/src" -w /src python:3.12-slim sh -c \
#     "pip install -q pip-tools && pip-compile -q --strip-extras --upgrade requirements.in"
# Dependabot (.github/dependabot.yml) proposes the updates weekly.

---
import type { GetStaticPaths } from 'astro'
import Layout from '@/layouts/Layout.astro'
import AlertBell from '@/components/AlertBell'
import BackLink from '@/components/BackLink'
import VenueDetail from '@/components/VenueDetail'
import { href } from '@/lib/basePath'
import { siteData } from '@/lib/siteData.server'

// One static page per exported Venue at its slug, and one at its id (/venues/2/), its permanent URL, redirecting to
// the slug; anything else is the 404 page. The page looks the Venue up from its URL (Astro's routing guide).
export const getStaticPaths = (() =>
  siteData().venueIds().flatMap(id => [{ params: { slug: siteData().venue(Number(id))!.slug } }, { params: { slug: id } }])
) satisfies GetStaticPaths

const { slug } = Astro.params
const venue = siteData().venueBySlug(slug)
if (!venue) return Astro.redirect(href(`/venues/${siteData().venue(Number(slug))!.slug}/`), 301)
const upcomingShows = siteData().venueShows(venue.id)
---

<Layout>
  <BackLink slot="back" />
  <VenueDetail venue={venue} upcomingShows={upcomingShows}>
    <AlertBell slot="bell" client:idle kind="venue" id={venue.id} name={venue.name} />
  </VenueDetail>
</Layout>

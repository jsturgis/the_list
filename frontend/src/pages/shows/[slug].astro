---
import type { GetStaticPaths } from 'astro'
import Layout from '@/layouts/Layout.astro'
import BackLink from '@/components/BackLink'
import ShowDetail from '@/components/ShowDetail'
import { href } from '@/lib/basePath'
import { slugAndIdPaths } from '@/lib/pagePaths'
import { siteData } from '@/lib/siteData.server'

// One static page per exported Show at its slug, and one at its id (/shows/102/), which never changes, redirecting to
// the slug; anything else is the 404 page. The page looks the Show up from its URL (Astro's routing guide).
export const getStaticPaths = (() =>
  slugAndIdPaths(siteData().showIds(), id => siteData().show(id)!.slug)) satisfies GetStaticPaths

const { slug } = Astro.params
const show = siteData().showBySlug(slug)
if (!show) return Astro.redirect(href(`/shows/${siteData().show(Number(slug))!.slug}/`), 301)
---

<Layout>
  <BackLink slot="back" />
  <ShowDetail show={show} />
</Layout>

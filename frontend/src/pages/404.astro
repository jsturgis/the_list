---
import { MusicalNoteIcon } from '@heroicons/react/24/outline'
import Layout from '@/layouts/Layout.astro'
import { href } from '@/lib/basePath'
---

<Layout>
  <div class="py-16 text-center flex flex-col items-center gap-3">
    <MusicalNoteIcon className="size-16 text-ink-faint" />
    <h1 class="w-full text-3xl text-ink sm:text-4xl">Page not found</h1>
    <p class="text-lg text-ink-soft">
      That show, band or venue isn&apos;t on The List, or it has dropped off since the last edition.
    </p>
    <a href={href('/')} class="text-lg text-link hover:underline">See this week&apos;s shows</a>
  </div>
</Layout>

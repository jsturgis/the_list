---
import { HomeIcon } from '@heroicons/react/20/solid'
import Layout from '@/layouts/Layout.astro'
import { ActionLink } from '@/components/ActionLinks'
import PageHeader from '@/components/PageHeader'
import { href } from '@/lib/basePath'
---

<Layout>
  <PageHeader
    title="Page not found"
    subtitle="That show, band or venue isn't on The List, or it has dropped off since the last edition."
  />
  <div>
    <ActionLink href={href('/')} kind="primary" icon={HomeIcon}>See this week&apos;s shows</ActionLink>
  </div>
</Layout>

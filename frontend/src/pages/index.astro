---
import Layout from '@/layouts/Layout.astro'
import HomeShows from '@/components/HomeShows'
import PageHeader from '@/components/PageHeader'
import { PAGE_SIZE } from '@/components/ShowList'
import { siteData } from '@/lib/siteData.server'

// The edition and the first page of Shows are in the HTML; the browser then loads every Show (home-shows.json)
// to filter them and keep scrolling.
const page = siteData().homePage(PAGE_SIZE)
---

<Layout width="wide">
  <PageHeader title="This Week's Shows">
    <Fragment slot="subtitle">
      {page.emailSubject ?? 'Upcoming Bay Area music'} — curated by{' '}
      <a href="mailto:skoepke@stevelist.com" class="text-link underline underline-offset-2">Steve List</a>.
    </Fragment>
  </PageHeader>
  <HomeShows page={page} client:load />
</Layout>

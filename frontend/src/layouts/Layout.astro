---
import '@fontsource-variable/figtree'
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url'
import '@/styles/globals.css'
import AlertsLink from '@/components/AlertsLink'
import { href } from '@/lib/basePath'
import { pastShowsStyle } from '@/lib/pastShows'
import { siteData } from '@/lib/siteData.server'
import { alertsAvailable } from '@/lib/supabase'

interface Props {
  title?: string
  description?: string
  /** Keep the page out of search indexes. */
  noindex?: boolean
  /** The content column (DESIGN.md, "Page width"): 672px for every page but the Shows list, which is wide. */
  width?: 'narrow' | 'wide'
}

const {
  title = 'The List — SF Bay Area Music',
  description = "Steve's weekly SF Bay Area music listing, enriched and made browsable.",
  noindex = false,
  width = 'narrow',
} = Astro.props

// Hides Shows dated before today, before anything is drawn: the page may have been built days ago.
const pastShowsScript =
  `document.head.append(Object.assign(document.createElement('style'), ` +
  `{ textContent: (${pastShowsStyle})(${JSON.stringify(siteData().exportDay)}) }))`
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <!-- Figtree (DESIGN.md): preload the Latin file so text renders in it from the start, not after a swap. -->
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={pastShowsScript} />
    <script is:inline>
      // The home page's built first page is unfiltered, so CSS holds it back while the URL may have filters, until
      // HomeShows has every Show. Only when JavaScript runs (data-js); if a script fails to load or throws, drop the
      // mark, so the first page shows rather than nothing.
      document.documentElement.dataset.js = ''
      if (location.search.length > 1) document.documentElement.dataset.query = ''
      addEventListener('error', e => {
        if (e instanceof ErrorEvent || e.target instanceof HTMLScriptElement) delete document.documentElement.dataset.js
      }, true)
    </script>
  </head>
  <body class="min-h-full bg-page text-ink">
    <!-- The first thing keyboard users reach: skip the header to the page's content. -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-on-accent"
    >Skip to content</a>
    <header class="border-b border-line-subtle bg-surface">
      <div class="max-w-5xl mx-auto px-4 py-4 flex items-center gap-2">
        <a href={href('/')} class="font-bold text-lg tracking-tight">The List</a>
        <span class="text-ink-muted text-sm">SF Bay Area Music</span>
        {alertsAvailable() && <AlertsLink />}
      </div>
    </header>
    <main id="main" tabindex="-1" class="max-w-5xl mx-auto px-4 py-6 outline-none">
      <div class:list={['flex flex-col gap-6', width === 'narrow' && 'mx-auto w-full max-w-2xl']}>
        <slot />
      </div>
    </main>
    <script>
      // Links that keep the Shows list's filters, and the Back link (lib/keepFilters).
      import { installLinkBehaviour } from '@/lib/keepFilters'
      installLinkBehaviour()
    </script>
  </body>
</html>
